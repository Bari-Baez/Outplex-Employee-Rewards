# Demo / dev-only controls
ALLOW_PUBLIC_DEMO_BOOTSTRAP=false
ALLOW_PUBLIC_DEMO_PROMOTE=false
DEV_BOOTSTRAP_TOKEN=
DEV_PROMOTE_TOKEN=
